# ==============================================================================
# Multi-stage Dockerfile for Google Cloud Run (Optimized with uv)
# ==============================================================================

# --- Stage 1: Build & Dependency Resolution ---
FROM python:3.13-slim AS builder

# uv ????????????????
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ??????????????
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# ?????????????? (????????)
COPY pyproject.toml uv.lock ./

# ??????????????? (--no-dev)
# ? editable ? dev ???????????? .venv ???
RUN uv sync --frozen --no-dev

# --- Stage 2: Production Runtime ---
FROM python:3.13-slim AS runner

# ?????????????????? (OpenMP, ???????)
RUN apt-get update && apt-get install -y --no-install-recommends     libgomp1     ca-certificates     && rm -rf /var/lib/apt/lists/*

# ?root??????? (????????)
RUN useradd -m -u 1000 appuser

WORKDIR /app

# builder ??????????????
COPY --from=builder --chown=appuser:appuser /app/.venv /app/.venv

# ?????????????????? (???: preprocess & learning)
COPY --chown=appuser:appuser preprocess /app/preprocess
COPY --chown=appuser:appuser learning /app/learning

# ?????????
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8080

# ???????????
USER appuser

# Cloud Run ? $PORT ????????????????
EXPOSE 8080

# ??????????????? (?: ??/??????????? Web API ????)
CMD ["python", "learning/main.py", "--stage", "downstream_task"]
